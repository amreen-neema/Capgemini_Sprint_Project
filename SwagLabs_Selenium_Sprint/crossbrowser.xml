<?xml version="1.0" encoding="UTF-8"?>


<suite name="SwagLabs Cross Browser Suite" parallel="tests" thread-count="2">

	<test name="Chrome Tests">
		<parameter name="browser" value="chrome" />
		<classes>
			<class name="SwagLabLogin.Login_testcase" />
			<class name="SwaglabProduct.Product_testcase" />
			<class name="SwagLabCheckOut.CheckOut_testcase" />
		</classes>
	</test>

	<test name="Edge Tests">
		<parameter name="browser" value="edge" />
		<classes>
			<class name="SwagLabLogin.Login_testcase" />
			<class name="SwaglabProduct.Product_testcase" />
			<class name="SwagLabCheckOut.CheckOut_testcase" />
		</classes>
	</test>

</suite>
